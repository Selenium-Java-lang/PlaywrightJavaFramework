<?xml version="1.0" encoding = "UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Regression Suite" verbose="1" thread-count="3" parallel="classes">
    <test name="Regression tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.FrameworkBuildTest"/>
            <class name="tests.MoreUIValidationsTest"/>
            <class name="tests.UIValidationsContinuedTest"/>
            <class name="tests.BasicsTest"/>
        </classes>
    </test>
</suite>